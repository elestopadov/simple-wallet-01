<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- Console appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- File appender for audit trail -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>logs/wallet.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>logs/wallet.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>30</maxHistory>
            <totalSizeCap>100MB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Domain events get INFO level -->
    <logger name="com.github.wallet.infrastructure.event" level="INFO"/>

    <!-- Use cases get INFO level -->
    <logger name="com.github.wallet.application" level="INFO"/>

    <!-- Infrastructure (persistence) gets DEBUG for troubleshooting -->
    <logger name="com.github.wallet.infrastructure.persistence" level="DEBUG"/>

    <!-- CLI layer gets WARN (less noisy) -->
    <logger name="com.github.wallet.cli" level="WARN"/>

    <!-- Root logger -->
    <root level="INFO">
        <appender-ref ref="FILE"/>
    </root>

</configuration>
